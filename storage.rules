rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function sameFamilyAs(userId) {
      return signedIn()
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId
              == firestore.get(/databases/(default)/documents/users/$(userId)).data.familyId
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId
              is string
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId.size() > 0;
    }

    match /profile_photos/{userId}.jpg {
      allow read: if isOwner(userId) || sameFamilyAs(userId);
      allow write: if isOwner(userId)
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }
  }
}
