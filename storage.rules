rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function sameFamilyAs(userId) {
      return signedIn()
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId
              == firestore.get(/databases/(default)/documents/users/$(userId)).data.familyId
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId
              is string
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId.size() > 0;
    }

    // Files are stored as profile_photos/{uid}.jpg (single path segment).
    match /profile_photos/{fileName} {
      function photoUid() {
        return fileName.replace('.jpg', '');
      }

      function isOwnPhoto() {
        return signedIn() && fileName == request.auth.uid + '.jpg';
      }

      allow read: if isOwnPhoto() || sameFamilyAs(photoUid());
      allow write: if isOwnPhoto()
          && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isOwnPhoto();
    }
  }
}
