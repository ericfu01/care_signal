# Copy this file to ".env" in the project root (same folder as pubspec.yaml).
# The ".env" file is gitignored — do not commit real keys.
#
# Option A — root ".env" (picked up on desktop when `flutter run` cwd is the project):
OPENAI_API_KEY=

# Option B — iOS / Android / simulator: edit `assets/openai.local.env` in this repo
# and set OPENAI_API_KEY=sk-... there (bundled as a Flutter asset). Restart the app
# after changing. Do not commit real keys.

# Option C — build-time (CI / devices):
#   flutter run --dart-define=OPENAI_API_KEY=sk-your-key-here
#   flutter run --dart-define-from-file=.env
#
# Music Therapy — search by name (opens the exact track/playlist in Spotify):
# Create an app at https://developer.spotify.com/dashboard
# Option A: assets/spotify.local.env (SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET)
# Option B: root .env with the same keys
# Option C: flutter run --dart-define=SPOTIFY_CLIENT_ID=... --dart-define=SPOTIFY_CLIENT_SECRET=...
#
# Without Spotify API keys, users can still paste a Spotify share link.
